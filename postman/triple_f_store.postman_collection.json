            "url": { "raw": "{{base_url}}/products?search=daging&category=1&min_price=10000&max_price=500000&sort=price&order=ASC", "host": ["{{base_url}}"], "path": ["products"], "query": [{"key":"search","value":"daging"},{"key":"category","value":"1"},{"key":"min_price","value":"10000"},{"key":"max_price","value":"500000"},{"key":"sort","value":"price"},{"key":"order","value":"ASC"}] }
