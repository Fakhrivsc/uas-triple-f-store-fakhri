            "body": { "mode": "raw", "raw": "{\n  \"ids\": [1, 2, 3],\n  \"is_active\": false\n}" },
            "url": { "raw": "{{base_url}}/products/bulk-status", "host": ["{{base_url}}"], "path": ["products", "bulk-status"] }
