          "name": "Create Produk (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key":"name","value":"Daging Sapi Premium","type":"text"},
                {"key":"description","value":"Daging sapi segar pilihan kualitas premium, cocok untuk berbagai olahan masakan","type":"text"},
                {"key":"price","value":"125000","type":"text"},
                {"key":"discount_price","value":"110000","type":"text"},
                {"key":"stock","value":"50","type":"text"},
                {"key":"weight_gram","value":"500","type":"text"},
                {"key":"category_id","value":"1","type":"text"},
                {"key":"is_active","value":"true","type":"text"},
                {"key":"images","src":"","type":"file","description":"Upload gambar produk (bisa lebih dari 1)"}
              ]
            },
            "url": { "raw": "{{base_url}}/products", "host": ["{{base_url}}"], "path": ["products"] }
          }
        },
